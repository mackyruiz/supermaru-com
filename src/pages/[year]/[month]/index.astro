---
import { allPosts, postPath } from '../../../lib/posts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
export async function getStaticPaths() {
  const posts = await allPosts();
  return [...new Set(posts.map(post => postPath(post).split('/').slice(0, 2).join('/')))].map(path => {
    const [year, month] = path.split('/');
    return { params: { year, month }, props: { posts: posts.filter(post => postPath(post).startsWith(path + '/')) } };
  });
}
const { posts } = Astro.props;
const { year, month } = Astro.params;
const monthName = new Intl.DateTimeFormat('en-US', { month: 'long', timeZone: 'UTC' }).format(new Date(`${year}-${month}-01T12:00:00Z`));
const title = `Posts from ${monthName} ${year}`;
---
<BaseLayout title={title} canonicalPath={`/${year}/${month}/`}><h1>{title}</h1><PostList posts={posts} /></BaseLayout>
