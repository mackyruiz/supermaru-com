---
import { allPosts, postPath } from '../../../lib/posts';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHead from '../../../components/PageHead.astro';
import PostList from '../../../components/PostList.astro';
export async function getStaticPaths() {
  const posts = await allPosts();
  return [...new Set(posts.map(post => postPath(post).split('/').slice(0, 2).join('/')))].map(path => {
    const [year, month] = path.split('/');
    return { params: { year, month }, props: { posts: posts.filter(post => postPath(post).startsWith(path + '/')) } };
  });
}
const { posts } = Astro.props;
const { year, month } = Astro.params;
const monthName = new Intl.DateTimeFormat('en-US', { month: 'long', timeZone: 'UTC' }).format(new Date(`${year}-${month}-01T12:00:00Z`));
---
<BaseLayout title={`Posts from ${monthName} ${year}`} canonicalPath={`/${year}/${month}/`}>
  <PageHead title={`${monthName} ${year}`} count={posts.length} context={`published in ${monthName} ${year}`} trail={[{ href: `/${year}/`, name: year! }]} />
  <div class="container page-body"><PostList posts={posts} /></div>
</BaseLayout>
