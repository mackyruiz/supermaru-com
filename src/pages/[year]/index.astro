---
import { allPosts, postPath } from '../../lib/posts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import PostList from '../../components/PostList.astro';
export async function getStaticPaths() {
  const posts = await allPosts();
  return [...new Set(posts.map(post => postPath(post).split('/')[0]))].map(year => ({
    params: { year }, props: { posts: posts.filter(post => postPath(post).startsWith(year + '/')) },
  }));
}
const { posts } = Astro.props;
const year = Astro.params.year!;
---
<BaseLayout title={`Posts from ${year}`} canonicalPath={`/${year}/`}>
  <PageHead title={year} count={posts.length} context={`published in ${year}`} />
  <div class="container page-body"><PostList posts={posts} /></div>
</BaseLayout>
