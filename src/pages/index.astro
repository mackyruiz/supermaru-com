---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const featured = posts.filter(p => p.data.featured).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<BaseLayout title="Macky Ruiz" description="Portfolio and resume" canonicalPath="/">
  <div class="container hero">
    <div class="hero-text">
      <h1 class="display">Macky Ruiz</h1>
      <p class="lead">Notes from the lab on networking, virtualization, and security, since 2014.</p>
      <div class="hero-links">
        <a href="/posts/" class="button">View Posts</a>
        <a href="/contact/" class="button button--secondary">Get in Touch</a>
      </div>
    </div>
    <img class="hero-art" src="/wp-content/uploads/2025/08/supermaru-logo-screenshot.png" alt="SuperMaru logo: illustrated portrait of Macky Ruiz" width="981" height="447" decoding="async" fetchpriority="high" />
  </div>

  {featured.length > 0 && (
    <section class="home-section">
      <div class="container">
        <h2>Featured Posts</h2>
        <div class="post-grid">
          {featured.map(post => <PostCard post={post} />)}
        </div>
        <a href="/posts/" class="readmore">View all posts →</a>
      </div>
    </section>
  )}
</BaseLayout>
