---
import BaseLayout from '../layouts/BaseLayout.astro';

const certs = [
  { name: 'CCNA Routing and Switching', detail: 'Cisco · Feb 2020', image: '/wp-content/uploads/2020/06/cisco_ccna_R_26S-300x300.png', href: 'https://www.youracclaim.com/badges/d5024a55-4f1a-49bc-96e4-6058135238eb/public_url' },
  { name: 'AWS Certified Solutions Architect – Associate', detail: 'Amazon Web Services · Mar 2020', image: '/wp-content/uploads/2020/06/AWS-Solution-Architect.png', href: 'https://www.credly.com/badges/1fcc9e05-c26c-4fd0-b601-f6ecbf309385' },
  { name: 'AWS Certified SysOps Administrator – Associate', detail: 'Amazon Web Services', image: '/wp-content/uploads/2024/01/image-300x300.png' },
  { name: 'VMware Certified Professional – Data Center Virtualization 2020', detail: 'VMware', image: '/wp-content/uploads/2021/06/Vmware_Cert_Prof_DCV20-300x300.png', href: 'https://www.credly.com/badges/34a8da05-571a-4244-b71b-2e0fde85cf7b' },
  { name: 'CompTIA Security+', detail: 'CompTIA · 2021', image: '/wp-content/uploads/2021/06/CompTIA_Security_2Bce-300x300.png', href: 'https://www.credly.com/badges/bd0fdb7d-c7bc-4894-acbb-90af2509aad0' },
  { name: 'ITIL 4 Foundation', image: '/wp-content/uploads/2024/01/0_1umAJMLBuqFTloHf-300x300.png' },
];

const training = [
  { title: 'Intro to Multi-Cloud Red Teaming', meta: 'BSidesLV · CyberWarfare Labs · 2025', text: 'Two-day AWS, GCP, and Azure red teaming CTF course.', href: '/posts/bsideslv-and-multi-cloud-security/' },
  { title: 'CIS-056 Network Security', meta: 'De Anza College · 2021', text: 'Security+ (SY0-501) preparation with hands-on cloud labs.' },
  { title: 'CNET-120 VMware Install, Configure and Manage', meta: 'Ohlone College', text: 'VMware Academy course leading to the VCP-DCV 2020 exams.' },
  { title: 'CIT016 Ethical Hacking', meta: 'Mission College · Fall 2018', text: 'Video projects on Pi-hole, PiVPN, OpenVAS, and cracking WPA2.', href: '/posts/ethical-hacking-final-fall-2018-mission-college/' },
  { title: 'Cisco Networking Academy', meta: '2011', text: 'Completed the CCNA curriculum.' },
];

const conferences = [
  { title: 'DEF CON', meta: 'Las Vegas · 2025' },
  { title: 'BSidesLV', meta: 'Las Vegas · 2025' },
  { title: 'VMworld', meta: 'San Francisco · 2015 · Booth staff' },
  { title: 'VMworld', meta: 'San Francisco · 2014 · Attendee' },
];

const skills = [
  { group: 'Virtualization', items: 'VMware vSphere, ESXi, vCenter Server Appliance, KVM / libvirt' },
  { group: 'Networking', items: 'Cisco routing and switching, Cisco DNA Center, UCS fabric interconnects, DNS (BIND9), DHCP' },
  { group: 'Linux and storage', items: 'Ubuntu, Fedora, CentOS, Raspberry Pi OS, ZFS, Samba, FreeNAS' },
  { group: 'Security', items: 'Kali Linux, aircrack-ng, OpenVAS, Burp Suite, cloud red teaming (AWS, GCP, Azure)' },
  { group: 'Cloud and automation', items: 'AWS, Python (requests), REST APIs, Bash, Docker, Ansible' },
];
---
<BaseLayout title="Resume" description="Certifications, training, and skills" canonicalPath="/resume/">
  <div class="container page-body">
    <h1>Resume</h1>

    <section class="resume-section">
      <h2>Certifications</h2>
      <ul class="badge-grid" role="list">
        {certs.map(cert => {
          const body = <>
            <img src={cert.image} alt="" loading="lazy" decoding="async" />
            <span>{cert.name}</span>
            {cert.detail && <span class="muted">{cert.detail}</span>}
          </>;
          return <li>{cert.href ? <a class="badge-card" href={cert.href}>{body}</a> : <div class="badge-card">{body}</div>}</li>;
        })}
      </ul>
    </section>

    <section class="resume-section">
      <h2>Education and training</h2>
      {training.map(item => (
        <div class="resume-item">
          <h3>{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h3>
          <p class="muted">{item.meta}</p>
          <p>{item.text}</p>
        </div>
      ))}
    </section>

    <section class="resume-section">
      <h2>Conferences</h2>
      {conferences.map(item => (
        <div class="resume-item">
          <h3>{item.title}</h3>
          <p class="muted">{item.meta}</p>
        </div>
      ))}
    </section>

    <section class="resume-section">
      <h2>Skills</h2>
      <div class="skill-grid">
        {skills.map(skill => (
          <div class="skill-category">
            <h3>{skill.group}</h3>
            <p>{skill.items}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
