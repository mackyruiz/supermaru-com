---
import { allPosts } from '../../lib/posts';
import { categories } from '../../data/taxonomies.json';
import { categoryName, categoryTrail } from '../../lib/taxonomies';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHead from '../../components/PageHead.astro';
import PostList from '../../components/PostList.astro';
export async function getStaticPaths() {
  const posts = await allPosts();
  const paths = new Set([...categories.map(term => term.path), ...posts.flatMap(post => post.data.categories)]);
  return [...paths].map(path => ({ params: { path }, props: {
    posts: posts.filter(post => post.data.categories.some(term => term === path || term.startsWith(path + '/'))),
  } }));
}
const { posts } = Astro.props;
const path = Astro.params.path!;
const name = categoryName(path);
---
<BaseLayout title={`Category: ${name}`} canonicalPath={`/category/${path}/`}>
  <PageHead title={name} count={posts.length} context={`filed under ${name}`} trail={[{ href: '/#topics', name: 'Topics' }, ...categoryTrail(path)]} />
  <div class="container page-body"><PostList posts={posts} showTopic={false} /></div>
</BaseLayout>
