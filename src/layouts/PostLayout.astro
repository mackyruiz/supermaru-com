---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import archived from '../data/comments.json';
import { postPath, formatDate } from '../lib/posts';
import { categoryName, tagName } from '../lib/taxonomies';
interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
  newer?: CollectionEntry<'posts'>;
  older?: CollectionEntry<'posts'>;
}
const { post, headings, newer, older } = Astro.props;
const { title, pubDate, description, heroImage, categories, tags } = post.data;
const comments = (archived as Record<string, { author: string; date: string; html: string }[]>)[post.id] ?? [];
// WordPress comment timestamps are local wall time. Format the calendar date without shifting it.
const commentDate = (date: string) => new Intl.DateTimeFormat('en-US', {
  timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric',
}).format(new Date(date + 'Z'));
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const hasToc = toc.length >= 3;
const minutes = Math.max(1, Math.round((post.body ?? '').split(/\s+/).filter(Boolean).length / 220));
---
<BaseLayout title={title} description={description} ogImage={heroImage} canonicalPath={`/${postPath(post)}/`}>
  <article class="post container">
    <header class="post-head">
      <h1>{title}</h1>
      <ul class="post-meta" role="list">
        <li><time class="measured cool" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time></li>
        <li class="measured muted">{minutes} min read</li>
        <li class="person">Macky Ruiz</li>
      </ul>
    </header>
    {heroImage && <figure class="post-hero"><img src={heroImage} alt="" fetchpriority="high" decoding="async" /></figure>}
    <div class="post-body" data-toc={hasToc ? 'true' : 'false'}>
      {hasToc && <Toc headings={toc} variant="inline" />}
      <div class="prose"><slot /></div>
      {hasToc && <Toc headings={toc} variant="rail" />}
    </div>
    <footer class="post-foot">
      {(categories.length > 0 || tags.length > 0) && <dl class="filed panels">
        {categories.length > 0 && <div><dt>Categories</dt><dd>{categories.map(term => <a class="chip" href={`/category/${term}/`}>{categoryName(term)}</a>)}</dd></div>}
        {tags.length > 0 && <div><dt>Tags</dt><dd>{tags.map(term => <a class="chip" href={`/tag/${term}/`}>{tagName(term)}</a>)}</dd></div>}
      </dl>}
      {(older || newer) && <nav class="pager panels" aria-label="More posts">
        {older && <a class="pager__item" rel="prev" href={`/${postPath(older)}/`}>
          <span class="pager__label">Older post</span><span class="pager__title">{older.data.title}</span>
        </a>}
        {newer && <a class="pager__item" rel="next" href={`/${postPath(newer)}/`}>
          <span class="pager__label">Newer post</span><span class="pager__title">{newer.data.title}</span>
        </a>}
      </nav>}
    </footer>
    {comments.length > 0 && <section class="comments" aria-labelledby="comments-heading">
      <h2 id="comments-heading">Comments ({comments.length})</h2>
      <p class="muted">Archived from the previous WordPress site. Comments are closed.</p>
      <ol class="comment-list panels" role="list">
        {comments.map(comment => <li class="comment">
          <div class="comment__by"><span class="person">{comment.author}</span><time class="measured cool" datetime={comment.date}>{commentDate(comment.date)}</time></div>
          <div class="prose comment__body" set:html={comment.html} />
        </li>)}
      </ol>
    </section>}
  </article>
</BaseLayout>
