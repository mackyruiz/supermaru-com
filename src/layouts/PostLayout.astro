---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import archived from '../data/comments.json';
import { postPath, formatDate } from '../lib/posts';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { title, pubDate, description, heroImage, categories, tags } = post.data;
const comments = (archived as Record<string, { author: string; date: string; html: string }[]>)[post.id] ?? [];
const label = (term: string) => term.split('/').at(-1)!.replaceAll('-', ' ');
// WordPress comment timestamps are local wall time. Format the calendar date without shifting it.
const commentDate = (date: string) => new Intl.DateTimeFormat('en-US', {
  timeZone: 'UTC', month: 'short', day: 'numeric', year: 'numeric',
}).format(new Date(date + 'Z'));
---
<BaseLayout title={title} description={description} ogImage={heroImage} canonicalPath={`/${postPath(post)}/`}>
  <article>
    <header class="post-header">
      <p class="eyebrow">Notes from the field</p>
      <h1>{title}</h1>
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <div class="chips" aria-label="Categories and tags">
        {categories.map((term) => <a class="chip" href={`/category/${term}/`}>{label(term)}</a>)}
        {tags.map((term) => <a class="chip tag" href={`/tag/${term}/`}>#{label(term)}</a>)}
      </div>
    </header>
    {heroImage && <img class="hero" src={heroImage} alt="" fetchpriority="high" />}
    <div class="prose"><slot /></div>
    {comments.length > 0 && <section class="comments" aria-labelledby="comments-heading">
      <h2 id="comments-heading">Comments ({comments.length})</h2>
      <p class="muted">Archived from the previous WordPress site. Comments are closed.</p>
      {comments.map((comment) => <article class="comment">
        <header><strong>{comment.author}</strong><time datetime={comment.date}>{commentDate(comment.date)}</time></header>
        <div class="prose" set:html={comment.html} />
      </article>)}
    </section>}
  </article>
</BaseLayout>
