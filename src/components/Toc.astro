---
interface Props { headings: { depth: number; slug: string; text: string }[]; variant: 'inline' | 'rail' }
const { headings, variant } = Astro.props;
---
{variant === 'inline'
  ? <details class="toc toc--inline"><summary>On this page</summary>
    <ol role="list" class="toc__list">{headings.map(h => <li class={`toc__item toc__item--d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
  </details>
  : <nav class="toc toc--rail" aria-label="On this page"><p class="toc__label">On this page</p>
    <ol role="list" class="toc__list">{headings.map(h => <li class={`toc__item toc__item--d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
  </nav>}
